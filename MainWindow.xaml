<Window x:Class="AccountTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:AccountTimer.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Account Timer" Height="750" Width="1200" MinWidth="800" MinHeight="500"
        Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
    
    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlAcrylicElementBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Style -->
        <Style x:Key="SidebarBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlAcrylicElementBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SystemControlAcrylicElementBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Accent Action Button -->
        <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e74c3c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c0392b"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#a93226"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Warning Button Style -->
        <Style x:Key="WarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e67e22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d35400"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#ba4a00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toggle Sidebar Button -->
            <Button Grid.Column="0" x:Name="ToggleSidebarButton" Click="ToggleSidebar_Click"
                    Style="{StaticResource ToggleButtonStyle}"
                    ToolTip="Toggle sidebar"
                    VerticalAlignment="Center">
                <TextBlock Text="☰" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Button>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="Account Timer" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Manage temporary accounts with automatic reset timers" 
                           FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="Auto" x:Name="SidebarSpacerColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" x:Name="SidebarPanel" Style="{StaticResource SidebarBorder}" Width="280">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lists" FontSize="16" FontWeight="SemiBold" 
                               Margin="8,4" Opacity="0.8"/>

                    <!-- Add List Button in Sidebar -->
                    <Button Grid.Row="2" Click="AddListButton_Click" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="12,10" FontSize="13" HorizontalAlignment="Stretch"
                            Margin="4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox Grid.Row="4" x:Name="ListsBox" 
                             ItemsSource="{Binding AccountLists}" 
                             SelectedItem="{Binding SelectedAccountList}" 
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="ui:ControlHelper.CornerRadius" Value="6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountListViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                               FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="×" Click="DeleteListButton_Click" 
                                            Tag="{Binding}" 
                                            Padding="6,2" 
                                            FontSize="16" 
                                            Width="28" 
                                            Height="28"
                                            ToolTip="Delete list"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="ui:ControlHelper.CornerRadius" Value="4"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#e74c3c"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Content -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel Margin="0,0,8,0">
                    <!-- List Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAccountList.Name}" 
                                       FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedAccountList.Accounts.Count, StringFormat='{}{0} accounts'}" 
                                       FontSize="13" Opacity="0.7" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding DeleteSelectedAccountsCommand}"
                                CommandParameter="{Binding SelectedAccountList}"
                                Style="{StaticResource ModernButtonStyle}"
                                MinWidth="140">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete Selected" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Click="AddAccountsButton_Click"
                                Style="{StaticResource AccentActionButtonStyle}"
                                MinWidth="140">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Accounts" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Global Settings Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="⚙ Global Settings" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Default reset duration:" 
                                           VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14"/>
                                
                                <ComboBox Grid.Column="1" x:Name="GlobalDurationCombo" 
                                          SelectedIndex="0" FontSize="14"
                                          SelectionChanged="GlobalDurationCombo_SelectionChanged">
                                    <ComboBoxItem Content="1 Week (7 days)" Tag="7"/>
                                    <ComboBoxItem Content="2 Weeks (14 days)" Tag="14"/>
                                    <ComboBoxItem Content="1 Month (30 days)" Tag="30"/>
                                    <ComboBoxItem Content="Custom..." Tag="custom"/>
                                </ComboBox>

                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="13" Opacity="0.7">
                                    <Run Text="Applies to new timers"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Accounts List -->
                    <ItemsControl ItemsSource="{Binding SelectedAccountList.Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                                <Border Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                    <Setter Property="Background" Value="#33e74c3c"/>
                                                    <Setter Property="BorderBrush" Value="#e74c3c"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Checkbox, Email, Duration, Copy -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" 
                                                      VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="2" Text="{Binding Email}" 
                                                       FontWeight="SemiBold" FontSize="15" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <ComboBox Grid.Column="4" x:Name="AccountDurationCombo" 
                                                      SelectedIndex="0" MinWidth="140" Height="32"
                                                      FontSize="13"
                                                      SelectionChanged="AccountDurationCombo_SelectionChanged"
                                                      Tag="{Binding}">
                                                <ComboBoxItem Content="1 Week" Tag="7"/>
                                                <ComboBoxItem Content="2 Weeks" Tag="14"/>
                                                <ComboBoxItem Content="1 Month" Tag="30"/>
                                                <ComboBoxItem Content="Custom..." Tag="custom"/>
                                            </ComboBox>
                                            
                                            <Button Grid.Column="6" Command="{Binding CopyEmailCommand}" 
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    MinWidth="80">
                                                <TextBlock Text="📋 Copy" FontSize="13"/>
                                            </Button>
                                        </Grid>

                                        <!-- Separator -->
                                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                                   Opacity="0.3" Margin="0,7"/>

                                        <!-- Bottom Row: Status, Actions, and Delete -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Status" FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                                    <Setter Property="Foreground" Value="#e74c3c"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="#2ecc71"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Foreground" Value="#f39c12"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="1" Command="{Binding ToggleSuspensionCommand}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    MinWidth="100">
                                                <TextBlock FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="⏸ Suspend"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                                    <Setter Property="Text" Value="▶ Unsuspend"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            
                                            <Button Grid.Column="3" Command="{Binding CancelTimerCommand}"
                                                    Visibility="{Binding IsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                    Style="{StaticResource WarningButtonStyle}"
                                                    MinWidth="100"
                                                    ToolTip="Cancel the timer and make this account available immediately">
                                                <TextBlock Text="✕ Cancel Timer" FontSize="13"/>
                                            </Button>
                                            
                                            <Button Grid.Column="5" Command="{Binding ResetTimerCommand}"
                                                    Visibility="{Binding IsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    MinWidth="90"
                                                    ToolTip="Reset this account to restart the timer period">
                                                <TextBlock Text="🔄 Reset" FontSize="13"/>
                                            </Button>
                                            
                                            <Button Grid.Column="7" Command="{Binding StartTimerCommand}"
                                                    IsEnabled="{Binding IsAvailable}" 
                                                    Style="{StaticResource AccentActionButtonStyle}"
                                                    MinWidth="110">
                                                <TextBlock Text="▶ Start Timer" FontSize="13"/>
                                            </Button>
                                            
                                            <Button Grid.Column="9" Command="{Binding DeleteAccountCommand}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Width="36"
                                                    ToolTip="Delete this account">
                                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border Visibility="{Binding SelectedAccountList, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="Transparent" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Opacity="0.5">
                            <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No accounts yet" FontSize="18" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Click 'Add Accounts' to get started" FontSize="14" 
                                       HorizontalAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
